# ===== سلة تيتا — Environment variables =====
# لا ترفعي ملف .env إلى Git. انسخي هذا الملف إلى .env وعدّلي القيم.

# قاعدة البيانات
# محليًا بدون Postgres:   DATABASE_URL=sqlite:./data/dev.sqlite
# مع Postgres:            DATABASE_URL=postgres://user:pass@localhost:5432/sallatteta
DATABASE_URL=sqlite:./data/dev.sqlite
# ضعيها true فقط إذا استعملتِ External Database URL من Render (من خارج Render)
DATABASE_SSL=false

# رقم WhatsApp الإدارة (بصيغة دولية، أرقام فقط) — تصله طلبات اشتراك الستات
ADMIN_WHATSAPP_NUMBER=961XXXXXXXX

# سر عشوائي طويل (32 حرف على الأقل) — إلزامي في الإنتاج
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# مسار لوحة الإدارة (يمكن تغييره لمسار أصعب تخمينه)
ADMIN_PATH=/admin

# إنشاء أول حساب إدارة تلقائيًا عند التشغيل (فقط إذا لا يوجد أي Admin). احذفيهما بعد أول دخول.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# رمز الدولة الافتراضي لتحويل الأرقام المحلية (03xxxxxx → 9613xxxxxx)
DEFAULT_COUNTRY_CODE=961

# على Render ضعيها 1 (لقراءة IP الحقيقي من X-Forwarded-For)
TRUST_PROXY=0
PORT=3000
NODE_ENV=development

# Optional: site link used in the cook login WhatsApp message (e.g. after connecting a custom domain)
# PUBLIC_BASE_URL=https://app.sallatteta.com

# Optional — database connections per server instance (default 10)
# DB_POOL_MAX=10

# Optional — store images on Cloudflare R2 / AWS S3 instead of the database (see docs/SCALING-PLAN.md)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=sallatteta-images
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://img.sallatteta.com
# S3_REGION=auto

# Optional — professional provider for towns/villages around a GPS point (more reliable than free map servers)
# GEOAPIFY_API_KEY=

# Optional — mobile apps: links to the site open the installed app
# ANDROID_PACKAGE_NAME=com.aklatak.app
# ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:…   (from PWABuilder / your signing key; comma-separated)
# IOS_APP_ID=TEAMID.com.aklatak.app

# Emergency only — forgot the admin password / lost the passkey phone. Set, deploy, sign in, then DELETE both.
# ADMIN_RESET_USERNAME=ali.takaji
# ADMIN_RESET_PASSWORD=

# Optional — translate texts edited in the admin panel into every language (DeepL; free plan keys end with :fx)
# DEEPL_API_KEY=

# --- performance & resilience (optional, safe defaults) ---
# DB_POOL_MAX=10                 # connections per instance (instances × this must stay below the database limit)
# DB_QUERY_TIMEOUT_MS=20000      # a stuck query frees its connection
# DATABASE_SSL_INSECURE=false    # true only if the database has no publicly trusted certificate
# GEO_SEARCH_WAIT_MS=400         # max wait for the map service during a search
# STORAGE_AUTO_MIGRATE=true      # move photos from the database to R2 automatically
# RETENTION_IMPRESSIONS_DAYS=180 · RETENTION_VISITS_DAYS=120 · RETENTION_PAGEVIEWS_DAYS=400 · RETENTION_ADMIN_LOGINS_DAYS=365
# POSTGIS=on                     # spatial index for nearest-first search (Neon: free). 'off' to disable
# REDIS_URL=                     # shared cache + rate limits across instances (Upstash / Render Key Value)
# REDIS_CACHE=on                 # 'off' keeps the cache per instance even with REDIS_URL

# --- Delivery (v7) — all optional ---
# SMS sign-in codes for customers (off until set):
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# Daily automatic copy of ALL data to a PRIVATE bucket (never the public photo bucket):
# BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=aklatak-backups
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# Phone notifications (Web Push) — generate once with: npm run vapid
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- v7.6: online money — the app works by hand (receipt → owner approves) until these are set ---
# Pay-in (a store tops up or renews online). The provider signs its callback with PAY_WEBHOOK_SECRET (HMAC-SHA256, header X-Signature).
# Callback address to give the provider: https://aklatak.net/api/pay/webhook
# PAY_CHECKOUT_URL=
# PAY_API_KEY=
# PAY_WEBHOOK_SECRET=
# v7.7: refunds of paid orders that were refused / cancelled, sent automatically: { reference, amount, currency, paymentId }
# PAY_REFUND_URL=
# PUBLIC_BASE_URL=https://aklatak.net
# Pay-out (withdrawals of drivers and stores sent automatically to Whish / OMT):
# PAYOUT_API_URL=
# PAYOUT_API_KEY=
# --- v7.7: drivers' settlements paid ONLINE with a fixed amount, confirmed automatically (each gateway is optional) ---
# Whish Pay merchant (collect link + signed callback). Callback address to give Whish: https://aklatak.net/api/pay/webhook/whish
# WHISH_PAY_URL=
# WHISH_PAY_KEY=
# WHISH_PAY_SECRET=
# OMT Pay merchant. Callback address: https://aklatak.net/api/pay/webhook/omt
# OMT_PAY_URL=
# OMT_PAY_KEY=
# OMT_PAY_SECRET=
# Separate payout keys per provider (else PAYOUT_API_URL/KEY above is used for both): restaurants' shares + withdrawals
# WHISH_PAYOUT_URL=
# WHISH_PAYOUT_KEY=
# OMT_PAYOUT_URL=
# OMT_PAYOUT_KEY=
# Road distances use GEOAPIFY_API_KEY (above). Daily limit: admin → Delivery → settings (free plan = 3000/day).
